<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_login">

    <!-- Logo -->
    <ImageView
        android:id="@+id/imag_logo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="80dp"
        android:src="@drawable/logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/txt_titulo_logo"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <!-- Título -->
    <TextView
        android:id="@+id/txt_titulo_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="PaulaCode"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#2D114D"
        app:layout_constraintTop_toTopOf="@id/imag_logo"
        app:layout_constraintBottom_toBottomOf="@id/imag_logo"
        app:layout_constraintStart_toEndOf="@id/imag_logo"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nombre Usuario -->
    <EditText
        android:id="@+id/edit_usuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:hint="Usuario"
        android:minHeight="50dp"
        android:textColor="#2D114D"
        android:textColorHint="#7E6A93"
        android:background="@drawable/fondo_input"
        app:layout_constraintTop_toBottomOf="@id/imag_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.20" />

    <!-- Contraseña -->
    <EditText
        android:id="@+id/edit_pass"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:minHeight="50dp"
        android:textColor="#2D114D"
        android:textColorHint="#7E6A93"
        android:background="@drawable/fondo_input"
        app:layout_constraintTop_toBottomOf="@id/edit_usuario"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.03" />

    <!-- Repetir Contraseña -->
    <EditText
        android:id="@+id/edit_pass_repeat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:hint="Repetir Contraseña"
        android:inputType="textPassword"
        android:minHeight="50dp"
        android:textColor="#2D114D"
        android:textColorHint="#7E6A93"
        android:background="@drawable/fondo_input"
        app:layout_constraintTop_toBottomOf="@id/edit_pass"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.03" />

    <!-- Validar -->
    <Button
        android:id="@+id/btn_validar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:text="VALIDAR"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#6C3483"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@+id/edit_pass_repeat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.30" />

</androidx.constraintlayout.widget.ConstraintLayout>